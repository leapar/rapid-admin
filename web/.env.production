# 生产环境配置
NODE_ENV=production

# 应用名称
VITE_APP_NAME=rapid-admin

# API 基础路径(同源部署,使用相对路径)
VITE_API_BASE=/rapid-admin/v1

# 生产环境无 Mock
VITE_USE_MOCK=false

# 日志级别
VITE_LOG_LEVEL=warn

# §2.5 #6 P1 —— Sentry 错误上报(空 = 关闭,生产前填实际 DSN)
#   - 阿里云 ARMS / Sentry / 自建 Sentry 兼容
#   - dev 模式(VITE_SENTRY_DSN 留空即可)
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0

# §2.3 #8 P1 —— 网络抖动重试(默认开;想关改 false)
VITE_HTTP_RETRY=true
VITE_HTTP_RETRY_MAX=3
VITE_HTTP_RETRY_BASE_MS=500

# §2.3 #11 P1 —— 多 baseURL 通道
VITE_API_BASE_ADMIN=/rapid-admin/v1
VITE_API_BASE_OWNER=/owner/v1
# VITE_API_BASE_SUPPLIER=/supplier/v1
