# 开发环境配置
NODE_ENV=development

# 应用名称
VITE_APP_NAME=rapid-admin

# API 基础路径(同源部署时用相对路径,跨域时填完整 URL)
VITE_API_BASE=/rapid-admin/v1

# 后端代理目标(开发环境 vite proxy 转发)
VITE_API_PROXY_TARGET=http://localhost:8888

# 文件上传 OSS 代理
VITE_OSS_PROXY_TARGET=http://localhost:8888

# 是否启用 Mock(开发期间先用 mock,联调时关掉)
VITE_USE_MOCK=true

# 日志级别 (debug | info | warn | error)
VITE_LOG_LEVEL=debug

# §2.3 #8 P1 —— 网络抖动重试(开发期默认开,生产期默认开,可关)
VITE_HTTP_RETRY=true
VITE_HTTP_RETRY_MAX=3
VITE_HTTP_RETRY_BASE_MS=500

# §2.3 #11 P1 —— 多 baseURL 通道(同仓三端共用)
#   - 不配的通道 fallback VITE_API_BASE
VITE_API_BASE_ADMIN=/rapid-admin/v1
VITE_API_BASE_OWNER=/owner/v1
# VITE_API_BASE_SUPPLIER=/supplier/v1
