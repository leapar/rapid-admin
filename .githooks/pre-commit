#!/usr/bin/env bash
# rapid-admin pre-commit hook
# 仓库内版本化 hook(2026-10-18 L4 新增)
#
# 启用方法(每个新 clone 一次):
#   git config core.hooksPath .githooks
#
# 跳过本次检查(不推荐):
#   git commit --no-verify
#
# 设计边界:
#   - core.hooksPath 只影响本仓库,不动用户全局 git config
#   - 不会污染其他项目
#   - 跟 husky/lefthook/lint-staged/commitlint 无任何依赖
#   - shell 脚本纯文本,无 npm install

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo -e "${YELLOW}=== rapid-admin pre-commit 检查 ===${NC}"

# ============================================================================
# 1. ESLint 字典硬编码检测(L2 兜底)
# ============================================================================
#    .eslintrc.cjs 已配置 no-restricted-syntax,pnpm lint 会自动跑
#    仅在 web/ 改动时跑(避免 go-only commit 误触发)
if git diff --cached --name-only | grep -q "^web/"; then
  echo -e "${YELLOW}[1/4] ESLint + 字典硬编码检测(改动涉及 web/)${NC}"
  if command -v pnpm >/dev/null 2>&1; then
    # pnpm 在 win32 上 lint 失败时 exit code 不可靠,直接 grep 输出
    LINT_OUT=$(pnpm --dir web lint 2>&1 || true)
    # 检测"硬编码 enum 映射"专用错误(emoji 在 win32 编码可能错位,用 ascii 关键字)
    if echo "$LINT_OUT" | grep -qE "no-restricted-syntax"; then
      echo -e "${RED}❌ ESLint 失败:检测到硬编码 enum 映射${NC}"
      echo -e "${RED}   改用:const { getLabel, getColor } = useDict('<groupCode>')${NC}"
      echo -e "${RED}   参考:web/src/hooks/useDict.ts + web/src/types/dict.ts${NC}"
      echo "$LINT_OUT" | grep -B 1 "no-restricted-syntax" | head -20
      exit 1
    fi
    echo -e "${GREEN}   ✓ ESLint 字典硬编码检测通过${NC}"
  else
    echo -e "${YELLOW}   ⚠ pnpm 未安装,跳过 ESLint(本机需 npm i -g pnpm)${NC}"
  fi
else
  echo -e "${YELLOW}[1/4] 跳过(本次改动不涉及 web/)${NC}"
fi

# ============================================================================
# 2. 后端构建(仅当 server/ 改动时,Go 编译 sanity)
# ============================================================================
if git diff --cached --name-only | grep -q "^server/"; then
  echo -e "${YELLOW}[2/4] Go 编译 sanity(改动涉及 server/)${NC}"
  if command -v go >/dev/null 2>&1; then
    if ! (cd server && go build ./...) 2>/dev/null; then
      echo -e "${RED}❌ Go 编译失败,请先修${NC}"
      echo -e "${RED}   cd server && go build ./...${NC}"
      exit 1
    fi
    echo -e "${GREEN}   ✓ Go 编译通过${NC}"
  else
    echo -e "${YELLOW}   ⚠ go 未安装,跳过(本机需装 Go 1.24+)${NC}"
  fi
else
  echo -e "${YELLOW}[2/4] 跳过(本次改动不涉及 server/)${NC}"
fi

# ============================================================================
# 3. 框架层未完成项清单自洽(改动涉及该清单时)
# ============================================================================
#    清单里每一个计数 / 百分比都必须和它自己的表格对得上 ——
#    计数模型见 scripts/check_backlog_consistency.py 的文件头。
#    ⚠️ 这条网存在的理由:那份清单此前**大面积说谎**(9 个「未完成」块其实全做完了),
#      照着它排期的人排出来的全是早已做完的事。改完清单忘了同步数字,这网当场拦。
# ⚠️ **必须加 `-c core.quotepath=false`** —— git 默认把非 ASCII 路径转义成
#    "docs/å..." 这种八进制,直接 grep 中文名**永远匹配不上**,
#    这条检查就会静默地永远不跑(假绿)。
if git -c core.quotepath=false diff --cached --name-only | grep -q "docs/框架层未完成项清单v1.md"; then
  echo -e "${YELLOW}[3/4] 框架层清单自洽检查(改动涉及该清单)${NC}"
  if command -v python >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; then
    PY=$(command -v python || command -v python3)
    # Windows 控制台是 GBK,✅ 之类会 UnicodeEncodeError —— 强制 utf-8
    if ! PYTHONIOENCODING=utf-8 "$PY" scripts/check_backlog_consistency.py; then
      echo -e "${RED}❌ 清单和表格对不上(见上面的行号),先改数字再提交${NC}"
      exit 1
    fi
    echo -e "${GREEN}   ✓ 清单自洽${NC}"
  else
    echo -e "${YELLOW}   ⚠ python 未安装,跳过清单检查${NC}"
  fi
else
  echo -e "${YELLOW}[3/4] 跳过(本次改动不涉及该清单)${NC}"
fi

# ============================================================================
# 4. AI 接入文档生成一致性(改动涉及数据源时)—— docs/ai-coding.md §5.3/§5.5
# ============================================================================
#    module-list.md 与 llms.txt 是**生成物**,数据源(SUMMARY / internal/pkg /
#    examples)变了而产物没跟 ⇒ 退出码 1。
#    同样需要 -c core.quotepath=false,理由同第 3 步。
AI_DOC_SRCS=$(git -c core.quotepath=false diff --cached --name-only | grep -E "^(server/docs/SUMMARY\.md|server/internal/pkg/|server/examples/)" | head -1)
if [ -n "$AI_DOC_SRCS" ]; then
  echo -e "${YELLOW}[4/4] AI 接入文档生成一致性(改动涉及 module-list / llms 数据源)${NC}"
  if command -v python >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; then
    PY=$(command -v python || command -v python3)
    if ! PYTHONIOENCODING=utf-8 "$PY" scripts/gen_ai_docs.py --check; then
      echo -e "${RED}❌ 生成产物过期,先跑:python scripts/gen_ai_docs.py${NC}"
      exit 1
    fi
    echo -e "${GREEN}   ✓ module-list / llms.txt 与数据源一致${NC}"
  else
    echo -e "${YELLOW}   ⚠ python 未安装,跳过生成一致性检查${NC}"
  fi
else
  echo -e "${YELLOW}[4/4] 跳过(本次改动不涉及生成数据源)${NC}"
fi

echo -e "${GREEN}=== pre-commit 通过 ✓ ===${NC}"
exit 0
